PORT=3000
# Vercel: add the Upstash Redis integration (Marketplace) so reports + proof ledger persist.
# It sets these automatically (either naming scheme works):
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Optional: fixed agent identity (64-byte JSON array, Solana CLI format). Otherwise generated once into Redis.
AGENT_KEYPAIR=
